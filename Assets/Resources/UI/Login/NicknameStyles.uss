.nickname-screen {
    position: absolute;
    width: 1440px;
    height: 900px;
    color: #f4eedb;
    -unity-background-scale-mode: scale-and-crop;
}
.game-title {
    position: absolute;
    top: 161px;
    left: 200px;
    width: 1040px;
    height: 110px;
    font-size: 82px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.game-subtitle {
    position: absolute;
    top: 277px;
    left: 390px;
    width: 660px;
    height: 34px;
    font-size: 20px;
    -unity-text-align: middle-center;
}
.nickname-panel {
    position: absolute;
    left: 360px;
    top: 430px;
    width: 720px;
    height: 368px;
    padding: 16px 47px 32px;
    background-color: #16292e;
    border-width: 1px;
    border-color: #556a62;
}
.panel-title {
    height: 40px;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.nickname-help {
    margin-top: 8px;
    height: 30px;
    color: #a7b8af;
    font-size: 15px;
    -unity-text-align: middle-center;
}
.nickname-row { flex-direction: row; height: 56px; margin-top: 18px; }
.nickname-input { flex-grow: 1; margin: 0; }
.nickname-input .unity-text-field__input {
    flex-grow: 1;
    background-color: #091416;
    border-width: 1px;
    border-color: #556a62;
    padding: 8px 16px;
    font-size: 24px;
    color: #f4eedb;
    -unity-text-align: middle-left;
    --unity-cursor-color: #f4eedb;
    --unity-selection-color: #285b55;
}
.nickname-input .unity-text-field__input:focus { border-color: #7be5bc; }
Button {
    margin: 0;
    border-width: 1px;
    border-color: #556a62;
    border-radius: 0;
    background-color: #285b55;
    color: #f4eedb;
    font-size: 14px;
    -unity-text-align: middle-center;
}
Button:hover { border-color: #7be5bc; background-color: #346b60; }
Button:disabled { opacity: 0.5; }
.check-nickname { width: 180px; margin-left: 16px; }
.change-account {
    position: absolute;
    top: 19px;
    right: 31px;
    width: 124px;
    height: 32px;
    background-color: #16292e;
}
.nickname-message {
    margin-top: 25px;
    height: 66px;
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.confirm-nickname { align-self: center; width: 388px; height: 54px; margin-top: 16px; }
