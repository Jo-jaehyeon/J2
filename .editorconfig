root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

[Assets/Scripts/Network/Protocol/{BasicProtocol,ChatProtocol,GameEnum,InGameProtocol}.cs]
generated_code = true

[*.g.cs]
generated_code = true

[*.cs]
tab_width = 4
